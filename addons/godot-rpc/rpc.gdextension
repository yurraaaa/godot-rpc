[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = false

[libraries]
linux.debug.x86_64 = "bin/libgodot_rpc.linux.debug.x86_64.so"
linux.release.x86_64 = "bin/libgodot_rpc.linux.release.x86_64.so"
windows.debug.x86_64 = "bin/godot_rpc.windows.debug.x86_64.dll"
windows.release.x86_64 = "bin/godot_rpc.windows.release.x86_64.dll"